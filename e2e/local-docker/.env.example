# Copy to .env (gitignored) or export in CI. The runner fills HONUA_SERVER_IMAGE from the manifest;
# override only for local experiments against a staging build.

# Server image — normally injected from ../../platform-manifest.yaml by the runner. Override to test a
# locally-built or staging image, e.g. ghcr.io/honua-io/honua-server:2026.1-rc.1
# HONUA_SERVER_IMAGE=ghcr.io/honua-io/honua-server:TBD

# Host ports
HONUA_SERVER_PORT=8080
HONUA_METRICS_PORT=9090

# --- SDK staging sources (artifact-consumption seam, plan §4d) -----------------------------------
# The runner installs SDKs FROM THESE, not from the public registries, so we exercise the exact
# staged artifacts. Point these at the staging registries during a release-train run. Leave unset to
# fall back to the public registry (local dev), or to a file:// path for a locally-packed artifact.
# TODO(#7): wire these to the real staging registries / packed tarballs from the candidate manifest.
# HONUA_NPM_REGISTRY=https://npm.pkg.github.com
# HONUA_PIP_INDEX_URL=https://staging.pypi.honua.io/simple
# HONUA_NUGET_SOURCE=https://nuget.pkg.github.com/honua-io/index.json

# SDK package coordinates + versions (default to manifest artifact coords).
# HONUA_SDK_JS_PKG=@honua-io/sdk-js
# HONUA_SDK_PY_PKG=honua-sdk
# HONUA_SDK_DOTNET_PKG=Honua.Sdk

# Turn BLOCKED/SKIPPED into hard failures (used once real images + metrics exist, and in the release
# train so the gate can actually FAIL). Default off so the per-PR job is honest while pins are TBD.
# E2E_REQUIRE_REAL=1
