contracts/baselines/**/*.json text eol=lf
certification/release-controls/** text eol=lf
tools/fixtures/dr/*.json text eol=lf

# First-publication receipts. Default to NO content conversion so that retained
# package bytes (.nupkg/.snupkg/.zip/.tar.gz, and anything not enumerated below)
# keep the exact hashes recorded in SHA256SUMS; re-enable LF normalization only
# for the textual receipt/checksum files.
certification/first-publication/** -text
certification/first-publication/**/*.json text eol=lf
certification/first-publication/**/*.md text eol=lf
certification/first-publication/**/*.sha256 text eol=lf
certification/first-publication/**/SHA256SUMS text eol=lf

# Candidate-bound receipts hash these files byte-for-byte (validate_dr_receipt.py,
# check_capacity_soak.py). A CRLF checkout on a Windows runner changed the digest
# and gate-dr rejected a trunk-signed receipt (run 34671766127, 2026-09-12).
platform-manifest.yaml text eol=lf
platform-lock.json text eol=lf
certification/capacity-envelope.v1.json text eol=lf
