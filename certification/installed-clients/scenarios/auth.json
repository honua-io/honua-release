{
  "schemaVersion": 1,
  "id": "sdk-auth",
  "title": "API-key and operator-bearer authentication, and a refused anonymous call",
  "promise": "A customer authenticates every published SDK with an API key or an operator bearer token, and the SDK surfaces the server's refusal of an anonymous call as an error instead of an empty success.",
  "steps": [
    {
      "id": "api-key-query",
      "oracle": "count",
      "description": "Read every sites feature with an API-key client. The count is the number of rows returned."
    },
    {
      "id": "bearer-admin-list",
      "oracle": "contains-service",
      "description": "List services through the admin client authenticated with an operator bearer token; the sites service is listed."
    },
    {
      "id": "bearer-query",
      "oracle": "count",
      "description": "Read every sites feature with a bearer-authenticated data client. The count is the number of rows returned."
    },
    {
      "id": "anonymous-refused",
      "oracle": "refused",
      "description": "Query the sites layer with no credential; the SDK must raise its documented error."
    }
  ],
  "receiptFields": [
    "client",
    "version",
    "integrity",
    "scenario",
    "step",
    "api",
    "status",
    "oracle"
  ],
  "clients": {
    "honua-sdk-python-wheel": {
      "api-key-query": "honua_sdk.HonuaClient(api_key=).feature_server(...).query",
      "bearer-admin-list": "honua_admin.HonuaAdminClient(auth_provider=StaticAuthProvider).list_services",
      "bearer-query": "honua_sdk.HonuaClient(auth_provider=StaticAuthProvider).feature_server(...).query",
      "anonymous-refused": "honua_sdk.HonuaClient().feature_server(...).query"
    },
    "honua-sdk-js": {
      "api-key-query": "HonuaClient({apiKey}).featureLayer().queryFeatures",
      "bearer-admin-list": "HonuaAdminClient({headers: Authorization}).call(listServices)",
      "bearer-query": "HonuaClient({bearerToken}).featureLayer().queryFeatures",
      "anonymous-refused": "HonuaClient({}).featureLayer().queryFeatures"
    },
    "honua-sdk-dotnet": {
      "api-key-query": "IHonuaFeatureServerClient.QueryAsync (HonuaSdkOptions.ApiKey)",
      "bearer-admin-list": "IHonuaAdminClient.ListServicesAsync (HonuaSdkOptions.BearerToken)",
      "bearer-query": "IHonuaFeatureServerClient.QueryAsync (HonuaSdkOptions.BearerToken)",
      "anonymous-refused": "IHonuaFeatureServerClient.QueryAsync (no credential)"
    }
  }
}
