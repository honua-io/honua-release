{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "honua.import-fidelity-source/v1",
  "title": "Authored import-fidelity source inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fixtures"
  ],
  "properties": {
    "schema": {
      "const": "honua.import-fidelity-source/v1"
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "points",
        "lines",
        "polygons",
        "tables",
        "domains-subtypes",
        "related-records",
        "attachments",
        "zm-curves",
        "nulls-int64-time",
        "renderer-time-metadata",
        "filters-crs",
        "auth",
        "pagination-limits",
        "bounded-large-data"
      ],
      "properties": {
        "points": {
          "$ref": "#/$defs/fixture"
        },
        "lines": {
          "$ref": "#/$defs/fixture"
        },
        "polygons": {
          "$ref": "#/$defs/fixture"
        },
        "tables": {
          "$ref": "#/$defs/fixture"
        },
        "domains-subtypes": {
          "$ref": "#/$defs/fixture"
        },
        "related-records": {
          "$ref": "#/$defs/fixture"
        },
        "attachments": {
          "$ref": "#/$defs/fixture"
        },
        "zm-curves": {
          "$ref": "#/$defs/fixture"
        },
        "nulls-int64-time": {
          "$ref": "#/$defs/fixture"
        },
        "renderer-time-metadata": {
          "$ref": "#/$defs/fixture"
        },
        "filters-crs": {
          "$ref": "#/$defs/fixture"
        },
        "auth": {
          "$ref": "#/$defs/fixture"
        },
        "pagination-limits": {
          "$ref": "#/$defs/fixture"
        },
        "bounded-large-data": {
          "$ref": "#/$defs/fixture"
        }
      }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceUrl",
        "layerId",
        "expectedSnapshotDigest"
      ],
      "properties": {
        "serviceUrl": {
          "type": "string",
          "pattern": "^https://[^?#@]+/(FeatureServer|MapServer)$"
        },
        "layerId": {
          "type": "integer",
          "minimum": 0
        },
        "expectedSnapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "expectedFilteredSnapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "expectedInventoryDigest": {
          "$ref": "#/$defs/digest"
        },
        "filter": {
          "type": "object"
        },
        "relatedLayers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceResourceId",
              "layerId",
              "expectedSnapshotDigest"
            ],
            "properties": {
              "sourceResourceId": {
                "type": "string",
                "minLength": 1
              },
              "layerId": {
                "type": "integer",
                "minimum": 0
              },
              "expectedSnapshotDigest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "migrationManifest": {
          "type": "object"
        },
        "relationships": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relationshipId",
              "originLayerId",
              "destinationLayerId",
              "keyField",
              "foreignKey"
            ],
            "properties": {
              "relationshipId": {
                "type": "integer"
              },
              "originLayerId": {
                "type": "integer"
              },
              "destinationLayerId": {
                "type": "integer"
              },
              "keyField": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "foreignKey": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            }
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
