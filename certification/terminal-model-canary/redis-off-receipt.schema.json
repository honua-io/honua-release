{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/terminal-model-redis-off-receipt-v1.json",
  "title": "Redis-off actual model serving/refusal receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "completedAt",
    "status",
    "mode",
    "attempt",
    "lockDigest",
    "failureAttribution",
    "scope",
    "candidate",
    "endpoint",
    "driver",
    "stages",
    "actions",
    "transcript",
    "provenance",
    "totals",
    "notices",
    "receiptSchema",
    "evidenceKey",
    "cell",
    "profile",
    "executionOutcome",
    "functionalGpExecuted",
    "servingProof",
    "refusalProof",
    "assertions",
    "journeyContract",
    "linkedEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/schemaVersion"
    },
    "generatedAt": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/generatedAt"
    },
    "completedAt": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/completedAt"
    },
    "status": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/status"
    },
    "mode": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/mode"
    },
    "attempt": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/attempt"
    },
    "lockDigest": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/lockDigest"
    },
    "serverImage": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/serverImage"
    },
    "failureAttribution": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/failureAttribution"
    },
    "scope": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/scope"
    },
    "candidate": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/candidate"
    },
    "endpoint": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/endpoint"
    },
    "driver": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/driver"
    },
    "stages": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/stages"
    },
    "actions": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/actions"
    },
    "transcript": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/transcript"
    },
    "provenance": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/provenance"
    },
    "totals": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/totals"
    },
    "notices": {
      "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/properties/notices"
    },
    "receiptSchema": {
      "const": "terminal-model-redis-off-receipt-v1"
    },
    "evidenceKey": {
      "const": "release.e2e.terminal-model-redis-off"
    },
    "cell": {
      "enum": [
        "aws-ecs/redis-off",
        "aws-serverless/redis-off"
      ]
    },
    "profile": {
      "const": "redis-off-serving-refusal"
    },
    "executionOutcome": {
      "enum": [
        "not-attempted",
        "refused",
        "unexpectedly-accepted"
      ]
    },
    "functionalGpExecuted": {
      "enum": [
        false,
        null
      ]
    },
    "servingProof": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modelActionSequence",
            "featureCount",
            "featureIds",
            "featuresSha256",
            "independentReadMatches",
            "fixtureBinding"
          ],
          "properties": {
            "modelActionSequence": {
              "type": "integer",
              "minimum": 1
            },
            "featureCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "featureIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "featuresSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "independentReadMatches": {
              "const": true
            },
            "fixtureBinding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "serviceId",
                "layerId",
                "seedManifestSha256",
                "seedScriptSha256",
                "seedSqlSha256",
                "expectedFeaturesSha256"
              ],
              "properties": {
                "serviceId": {
                  "const": "e2e"
                },
                "layerId": {
                  "type": "integer",
                  "minimum": 0
                },
                "seedManifestSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "seedScriptSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "seedSqlSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "expectedFeaturesSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      ]
    },
    "refusalProof": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topology",
            "rulingStatus",
            "tool",
            "code",
            "missingDependency",
            "manifestCapability",
            "manifestReasonCode",
            "modelActionSequence",
            "acknowledgementActionSequence"
          ],
          "properties": {
            "ruling": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "deploymentEnvironment": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "capability": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "topology": {
              "const": "redis-off"
            },
            "rulingStatus": {
              "const": "ruled"
            },
            "code": {
              "const": "unavailable"
            },
            "missingDependency": {
              "const": "redis"
            },
            "manifestCapability": {
              "const": "jobs.runner"
            },
            "manifestReasonCode": {
              "const": "dependency-unavailable"
            },
            "modelActionSequence": {
              "type": "integer",
              "minimum": 1
            },
            "acknowledgementActionSequence": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "servingRead",
        "typedRedisRefusal",
        "modelAcknowledgedRefusal",
        "authentication",
        "anonymousDenial",
        "viewerDenial",
        "catalogExact",
        "signedModelProvenance"
      ],
      "properties": {
        "servingRead": {
          "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/$defs/assertionStatus"
        },
        "typedRedisRefusal": {
          "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/$defs/assertionStatus"
        },
        "modelAcknowledgedRefusal": {
          "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/$defs/assertionStatus"
        },
        "authentication": {
          "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/$defs/assertionStatus"
        },
        "anonymousDenial": {
          "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/$defs/assertionStatus"
        },
        "viewerDenial": {
          "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/$defs/assertionStatus"
        },
        "catalogExact": {
          "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/$defs/assertionStatus"
        },
        "signedModelProvenance": {
          "$ref": "https://honua.io/schemas/terminal-model-canary-receipt-v1.json#/$defs/assertionStatus"
        }
      }
    },
    "journeyContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "schemaVersion",
        "evidenceKey",
        "receiptSchema"
      ],
      "properties": {
        "path": {
          "const": "certification/terminal-model-canary/redis-off-serving-refusal.v1.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "evidenceKey": {
          "type": "string",
          "minLength": 1
        },
        "receiptSchema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "linkedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministicJourney",
        "deterministicReceipt",
        "servingFixture"
      ],
      "properties": {
        "deterministicJourney": {
          "const": "honua-release#123"
        },
        "deterministicReceipt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "generatedAt",
                "status",
                "candidateVerified",
                "freshnessVerified",
                "prerequisiteProfile",
                "sourceStatus"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "generatedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "status": {
                  "const": "pass"
                },
                "candidateVerified": {
                  "const": true
                },
                "freshnessVerified": {
                  "const": true
                },
                "prerequisiteProfile": {
                  "const": "redis-off-serving-refusal"
                },
                "sourceStatus": {
                  "enum": [
                    "pass",
                    "blocked"
                  ]
                }
              }
            }
          ]
        },
        "servingFixture": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "executionOutcome": {
            "const": "refused"
          },
          "functionalGpExecuted": {
            "const": false
          },
          "servingProof": {
            "type": "object"
          },
          "refusalProof": {
            "type": "object",
            "properties": {
              "acknowledgementActionSequence": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "assertions": {
            "properties": {
              "servingRead": {
                "const": "pass"
              },
              "typedRedisRefusal": {
                "const": "pass"
              },
              "modelAcknowledgedRefusal": {
                "const": "pass"
              },
              "authentication": {
                "const": "pass"
              },
              "anonymousDenial": {
                "const": "pass"
              },
              "viewerDenial": {
                "const": "pass"
              },
              "catalogExact": {
                "const": "pass"
              },
              "signedModelProvenance": {
                "const": "pass"
              }
            }
          }
        }
      }
    }
  ]
}
