{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/protocol-certification.v1.schema.json",
  "title": "Honua protocol certification ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requirements_revision", "requirements_complete", "generated_at", "candidate", "cells"],
  "properties": {
    "schema": { "const": "honua.protocol-certification/v1" },
    "requirements_revision": { "type": "string", "minLength": 1 },
    "requirements_complete": { "type": "boolean" },
    "generated_at": { "type": "string", "format": "date-time" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha", "image_digest", "cut_at"],
      "properties": {
        "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "cut_at": { "type": "string", "format": "date-time" }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cell" }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_key", "surface", "operation", "maturity", "canonical_client",
        "client_lane", "client_version", "deployment_target", "required_tier", "licensed",
        "addressable_by_client", "addressability_reason", "result", "skip_reason",
        "scenario_facets", "contract_revision", "auth_policy_revision", "source_sha",
        "producer_source_sha",
        "image_digest", "fixture_revision", "evidence_uri", "evidence_digest", "facet_results",
        "started_at", "completed_at",
        "budget_expectations", "budget_observations"
      ],
      "properties": {
        "capability_key": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "maturity": { "enum": ["supported", "preview", "experimental", "roadmap", "deprecated", "internal"] },
        "canonical_client": { "type": "string", "minLength": 1 },
        "client_lane": { "type": "string", "minLength": 1 },
        "client_version": { "type": "string", "minLength": 1 },
        "deployment_target": { "type": "string", "minLength": 1 },
        "required_tier": { "enum": ["pr", "nightly", "release"] },
        "licensed": { "type": "boolean" },
        "addressable_by_client": { "type": "boolean" },
        "addressability_reason": { "type": ["string", "null"] },
        "result": { "enum": ["pass", "fail", "skip", "not-addressable"] },
        "skip_reason": { "type": ["string", "null"] },
        "scenario_facets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["positive", "negative", "boundary", "auth", "pagination", "limit", "crs-axis", "media-schema", "cancellation-idempotency", "recovery", "metadata", "range-efficiency", "mutation"]
          }
        },
        "contract_revision": { "type": "string", "minLength": 1 },
        "auth_policy_revision": { "type": "string", "minLength": 1 },
        "source_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "producer_source_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "image_digest": { "type": ["string", "null"] },
        "fixture_revision": { "type": ["string", "null"] },
        "evidence_uri": { "type": ["string", "null"], "format": "uri" },
        "evidence_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "facet_results": {
          "type": ["object", "null"],
          "propertyNames": {
            "enum": ["positive", "negative", "boundary", "auth", "pagination", "limit", "crs-axis", "media-schema", "cancellation-idempotency", "recovery", "metadata", "range-efficiency", "mutation"]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["result", "evidence_digest"],
            "properties": {
              "result": { "enum": ["pass", "fail", "skip"] },
              "evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "budget_expectations": { "type": ["object", "null"] },
        "budget_observations": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "requests", "transferred_bytes", "full_object_downloads", "range_requests",
            "cache_hits", "coordinate_error", "geometry_error", "metadata_assertions", "metadata_values"
          ],
          "properties": {
            "requests": { "type": "integer", "minimum": 0 },
            "transferred_bytes": { "type": "integer", "minimum": 0 },
            "full_object_downloads": { "type": "integer", "minimum": 0 },
            "range_requests": { "type": "integer", "minimum": 0 },
            "cache_hits": { "type": "integer", "minimum": 0 },
            "coordinate_error": { "type": "number", "minimum": 0 },
            "geometry_error": { "type": "number", "minimum": 0 },
            "metadata_assertions": {
              "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }
            },
            "metadata_values": { "type": "object" }
          }
        }
      }
    }
  }
}
