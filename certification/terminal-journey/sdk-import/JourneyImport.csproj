<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Supplied from the integrity-verified manifest package, never a floating default. -->
    <PackageReference Include="Honua.Sdk.Admin" Version="[$(JourneySdkVersion)]" />
  </ItemGroup>
  <Target Name="RequirePublishedVersion" BeforeTargets="Restore;Build">
    <Error Condition="'$(JourneySdkVersion)' == ''" Text="A manifest-bound published JourneySdkVersion is required." />
  </Target>
</Project>
