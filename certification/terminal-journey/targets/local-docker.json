{
  "schemaVersion": 1,
  "id": "local-docker",
  "kind": "local-docker",
  "description": "Owner decision 2026-08-18: the 2026.1 demo venue is local Docker first. This target reuses the repository's existing Phase-A seam compose file so the server image is injected from platform-manifest.yaml and the driver can never run against a floating tag.",
  "compose": {
    "file": "certification/terminal-journey/targets/build-compose.yml",
    "project": "honua-terminal-journey",
    "serverService": "server",
    "imageEnv": "HONUA_SERVER_IMAGE",
    "portEnv": "HONUA_SERVER_PORT",
    "port": 8137,
    "notes": "Isolated PostGIS, Redis, authored GeoServices source, and two exact-candidate server replicas. Licensing remains disabled."
  },
  "adminPassword": {
    "env": "HONUA_ADMIN_PASSWORD",
    "default": "honua-console-dev-key",
    "notes": "Installer-provisioned bootstrap credential from the compose file. Never emitted into a receipt."
  },
  "endpoints": {
    "readiness": "/healthz/ready",
    "liveness": "/healthz/live",
    "capabilityManifest": "/api/v1/capabilities/manifest",
    "adminVersion": "/api/v1/admin/version",
    "adminCapabilities": "/api/v1/admin/capabilities",
    "adminApiKeys": "/api/v1/admin/api-keys/",
    "mcp": "/mcp"
  },
  "budgets": {
    "readinessTimeoutSeconds": 300,
    "teardownTimeoutSeconds": 300
  },
  "revisions": {
    "fixtureRevision": "terminal-zero-to-map-v1",
    "configRevision": "terminal-profiles-v1",
    "authPolicyRevision": "terminal-separate-principals-v1"
  },
  "replicaBaseUrl": "http://127.0.0.1:8138",
  "principals": {
    "proposer": "HONUA_JOURNEY_PROPOSER_KEY",
    "approver": "HONUA_JOURNEY_APPROVER_KEY"
  },
  "execution": {
    "datasource": {
      "name": "journey_source",
      "host": "db",
      "databaseName": "honua",
      "username": "honua",
      "passwordEnv": "HONUA_JOURNEY_DATASOURCE_PASSWORD",
      "sslRequired": false,
      "sslMode": "Disable"
    },
    "importRequest": {
      "serviceUrl": "http://source:8080/arcgis/rest/services/journey/FeatureServer",
      "layerId": 0,
      "tableName": "journey_source",
      "targetSchema": "public",
      "targetSrid": 4326,
      "autoPublish": false
    },
    "publishRequest": {
      "schema": "public",
      "table": "journey_source",
      "layerName": "journey_source",
      "geometryColumn": "geom",
      "geometryType": "Point",
      "srid": 4326,
      "primaryKey": "objectid",
      "serviceName": "journey"
    },
    "serviceId": "journey",
    "featurePath": "/ogc/features/collections/journey:{layerId}/items",
    "features": [
      {
        "type": "Feature",
        "properties": {
          "journey_id": 1
        },
        "geometry": {
          "type": "Point",
          "coordinates": [
            0,
            0
          ]
        }
      },
      {
        "type": "Feature",
        "properties": {
          "journey_id": 2
        },
        "geometry": {
          "type": "Point",
          "coordinates": [
            1,
            1
          ]
        }
      }
    ],
    "styleId": "journey-solid-red",
    "style": {
      "version": 8,
      "sources": {},
      "layers": [
        {
          "id": "journey-points",
          "type": "circle",
          "source": "journey",
          "paint": {
            "circle-radius": 8,
            "circle-color": "#ef2020",
            "circle-opacity": 1,
            "circle-stroke-width": 0
          }
        }
      ]
    },
    "bbox": [
      -2,
      -2,
      2,
      2
    ],
    "pixelPoint": [
      0,
      0
    ],
    "renderSize": [
      128,
      128
    ],
    "pixelRgba": [
      239,
      32,
      32,
      255
    ],
    "buffer": {
      "point": [
        0,
        0
      ],
      "srid": 3857,
      "distance": 2
    },
    "mapBody": {
      "layers": [
        {
          "id": "journey-layer",
          "sourceId": "journey",
          "type": "point",
          "visible": true
        }
      ],
      "view": {
        "center": [
          0,
          0
        ],
        "zoom": 4
      }
    },
    "route": "journey-map",
    "publishedPath": "/api/v1/studio/published/journey-map"
  }
}
