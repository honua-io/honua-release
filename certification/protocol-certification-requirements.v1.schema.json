{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/protocol-certification-requirements.v1.schema.json",
  "title": "Honua protocol certification requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "complete", "scope_notes", "source_revisions", "requirements"],
  "properties": {
    "schema": { "const": "honua.protocol-certification-requirements/v1" },
    "revision": { "type": "string", "minLength": 1 },
    "complete": { "type": "boolean" },
    "scope_notes": { "type": "string", "minLength": 1 },
    "source_revisions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit"],
        "properties": {
          "repository": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_key", "surface", "operation", "maturity", "canonical_client", "client_lane",
          "client_version", "deployment_target", "required_tier", "licensed", "addressable_by_client",
          "addressability_reason", "scenario_facets", "contract_revision", "auth_policy_revision",
          "fixture_revision"
        ],
        "properties": {
          "capability_key": { "type": "string", "minLength": 1 },
          "surface": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "maturity": { "enum": ["supported", "preview", "experimental", "roadmap", "deprecated", "internal"] },
          "canonical_client": { "type": "string", "minLength": 1 },
          "client_lane": { "type": "string", "minLength": 1 },
          "client_version": { "type": "string", "minLength": 1 },
          "deployment_target": { "type": "string", "minLength": 1 },
          "required_tier": { "enum": ["pr", "nightly", "release"] },
          "licensed": { "type": "boolean" },
          "addressable_by_client": { "type": "boolean" },
          "addressability_reason": { "type": ["string", "null"] },
          "scenario_facets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "contract_revision": { "type": "string", "minLength": 1 },
          "auth_policy_revision": { "type": "string", "minLength": 1 },
          "fixture_revision": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
