{
  "schemaVersion": 1,
  "scenario": "P16",
  "derivation": "Bootstrap revocation uses the reviewed runner custody fact and a fresh negative probe. Key lifecycle and secret scanning remain unscored until the same model-issued credential and scan inventory have runner-owned bindings. API-key listing is not a reviewed inventory.",
  "variants": {
    "A": {
      "key.read-only": null,
      "key.revoked": {
        "requests": [
          {
            "principalId": {
              "$role": "created:key"
            },
            "method": "GET",
            "resourceId": {
              "$role": "seeded:service:item"
            },
            "status": 200
          },
          {
            "principalId": {
              "$role": "created:key"
            },
            "method": "GET",
            "resourceId": {
              "$role": "seeded:service:item"
            },
            "status": 401
          }
        ]
      },
      "secrets.absent": null,
      "custody.bootstrap-revoked": {
        "bootstrapPrincipalId": {
          "$role": "seeded:principal:bootstrap"
        },
        "revokedCredentialIds": [
          {
            "$role": "seeded:principal:bootstrap"
          }
        ],
        "postRevocationProbeStatus": 401
      },
      "custody.worker-replaced": {
        "$excluded": "custody.worker-replaced@local-docker"
      }
    },
    "B": {
      "key.read-only": null,
      "key.revoked": {
        "requests": [
          {
            "principalId": {
              "$role": "created:key"
            },
            "method": "GET",
            "resourceId": {
              "$role": "seeded:service:item"
            },
            "status": 200
          },
          {
            "principalId": {
              "$role": "created:key"
            },
            "method": "GET",
            "resourceId": {
              "$role": "seeded:service:item"
            },
            "status": 401
          }
        ]
      },
      "secrets.absent": null,
      "custody.bootstrap-revoked": {
        "bootstrapPrincipalId": {
          "$role": "seeded:principal:bootstrap"
        },
        "revokedCredentialIds": [
          {
            "$role": "seeded:principal:bootstrap"
          }
        ],
        "postRevocationProbeStatus": 401
      },
      "custody.worker-replaced": {
        "$excluded": "custody.worker-replaced@local-docker"
      }
    }
  },
  "customerFiles": {
    "A": [],
    "B": []
  },
  "roles": [
    {
      "role": "seeded:principal:bootstrap",
      "step": "runner-custody-mint-bootstrap",
      "pointer": "/data/apiKey/id"
    }
  ],
  "projections": {
    "custody.bootstrap-revoked": {
      "spec": {
        "object": {
          "bootstrapPrincipalId": {
            "custody": "bootstrapPrincipalId"
          },
          "revokedCredentialIds": {
            "custody": "bootstrapRevokedCredentialIds"
          },
          "postRevocationProbeStatus": {
            "status": "p15-bootstrap-probe"
          }
        }
      },
      "reads": {
        "p15-bootstrap-probe": {
          "kind": "http",
          "method": "GET",
          "path": "/api/v1/admin/api-keys/",
          "principal": "bootstrap",
          "phase": "observe"
        }
      }
    }
  }
