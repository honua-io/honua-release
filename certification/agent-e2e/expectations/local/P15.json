  "projections": {
    "publication.private": {
      "spec": {
        "object": {
          "requests": {
            "each": [
              "p15-operator",
              "p15-anonymous"
            ],
            "to": {
              "object": {
                "principalId": {
                  "principal": "$step"
                },
                "method": {
                  "method": "$step"
                },
                "resourceId": {
                  "body": "p15-operator",
                  "pointer": "/data/itemId"
                },
                "status": {
                  "status": "$step"
                },
                "responseSha256": {
                  "sha256": "$step"
                },
                "disclosedResourceIds": {
                  "disclosed": "$step",
                  "roles": [
                    "seeded:map:item"
                  ]
                }
              }
            }
          },
          "versionId": {
            "body": "p15-operator",
            "pointer": "/data/versionId"
          },
          "contentHash": {
            "body": "p15-operator",
            "pointer": "/data/contentHash"
          },
          "visibility": {
            "body": "p15-operator",
            "pointer": "/data/visibility"
          },
          "operatorId": {
            "body": "p15-operator-grants",
            "pointer": "/data/id"
          },
          "operatorPermissions": {
            "body": "p15-operator-grants",
            "pointer": "/data/permissions"
          },
          "operatorStatus": {
            "body": "p15-operator-grants",
            "pointer": "/data/status"
          },
          "operatorActive": {
            "body": "p15-operator-grants",
            "pointer": "/data/canAuthenticate"
          }
        }
      },
      "reads": {
        "p15-operator": {
          "kind": "http",
          "method": "GET",
          "path": "/api/v1/studio/published(?:/[A-Za-z0-9_-]{1,100}){1,8}",
          "principal": "operator",
          "phase": "observe"
        },
        "p15-anonymous": {
          "kind": "http",
          "method": "GET",
          "path": "/api/v1/studio/published(?:/[A-Za-z0-9_-]{1,100}){1,8}",
          "principal": "anonymous",
          "phase": "observe"
        },
        "p15-operator-grants": {
          "kind": "http",
          "method": "GET",
          "path": "/api/v1/admin/api-keys/[^/]+/effective-permissions",
          "principal": "controller",
          "phase": "observe"
        }
      }
    },
    "source-content.unchanged": {
      "spec": {
        "protectedContent": [
          {
            "label": "shelters",
            "before": "p15-source-before",
            "after": "p15-source-after",
            "resource": [
              "seeded:service:shelters",
              "seeded:layer:shelters"
            ]
          }
        ]
      },
      "reads": {
        "p15-source-before": {
          "kind": "http",
          "method": "GET",
          "principal": "controller",
          "phase": "seed",
          "path": "/rest/services/[^/?]+/FeatureServer/[0-9]+/query\\?f=json&where=1%3D1&outFields=%2A&returnGeometry=true&outSR=3857&orderByFields=source_id\\+ASC&resultRecordCount=1000"
        },
        "p15-source-after": {
          "kind": "http",
          "method": "GET",
          "principal": "controller",
          "phase": "observe",
          "path": "/rest/services/[^/?]+/FeatureServer/[0-9]+/query\\?f=json&where=1%3D1&outFields=%2A&returnGeometry=true&outSR=3857&orderByFields=source_id\\+ASC&resultRecordCount=1000"
        }
      }
    },
    "custody.bootstrap-revoked": {
      "spec": {
        "object": {
          "bootstrapPrincipalId": {
            "custody": "bootstrapPrincipalId"
          },
          "revokedCredentialIds": {
            "custody": "bootstrapRevokedCredentialIds"
          },
          "postRevocationProbeStatus": {
            "status": "p15-bootstrap-probe"
          }
        }
      },
      "reads": {
        "p15-bootstrap-probe": {
          "kind": "http",
          "method": "GET",
          "path": "/api/v1/admin/api-keys/",
          "principal": "bootstrap",
          "phase": "observe"
        }
      }
    }
  }
}
