  "roles": [
    {
      "role": "seeded:map:item",
      "step": "p15-map-saved",
      "pointer": "/data/itemId"
    },
    {
      "role": "seeded:map:version",
      "step": "p15-map-saved",
      "pointer": "/data/versionId"
    },
    {
      "role": "seeded:map:hash",
      "step": "p15-map-saved",
      "pointer": "/data/contentHash"
    },
    {
      "role": "seeded:principal:operator",
      "step": "runner-principal-operator",
      "pointer": "/data/apiKey/id"
    },
    {
      "role": "seeded:principal:bootstrap",
      "step": "runner-custody-mint-bootstrap",
      "pointer": "/data/apiKey/id"
    },
    {
      "role": "seeded:service:shelters",
      "step": "publish-shelters-submit",
      "pointer": "/data/resourceIds/serviceName"
    },
    {
      "role": "seeded:layer:shelters",
      "step": "publish-shelters-submit",
      "pointer": "/data/resourceIds/layerId"
    }
