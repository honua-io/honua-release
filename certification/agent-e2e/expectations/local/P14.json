          },
          "revokedCredentialIds": {
            "custody": "bootstrapRevokedCredentialIds"
          },
          "postRevocationProbeStatus": {
            "status": "p15-bootstrap-probe"
          }
        }
      },
      "reads": {
        "p15-bootstrap-probe": {
          "kind": "http",
          "method": "GET",
          "path": "/api/v1/admin/api-keys/",
