          "phase": "observe"
        }
      }
    },
    "source-content.unchanged": {
      "spec": {
        "protectedContent": [
          {
            "label": "shelters",
            "before": "p15-source-before",
            "after": "p15-source-after",
            "resource": [
              "seeded:service:shelters",
              "seeded:layer:shelters"
            ]
          }
        ]
      },
      "reads": {
        "p15-source-before": {
          "kind": "http",
          "method": "GET",
          "principal": "controller",
          "phase": "seed",
          "path": "/rest/services/[^/?]+/FeatureServer/[0-9]+/query\\?f=json&where=1%3D1&outFields=%2A&returnGeometry=true&outSR=3857&orderByFields=source_id\\+ASC&resultRecordCount=1000"
        },
        "p15-source-after": {
          "kind": "http",
          "method": "GET",
          "principal": "controller",
          "phase": "observe",
          "path": "/rest/services/[^/?]+/FeatureServer/[0-9]+/query\\?f=json&where=1%3D1&outFields=%2A&returnGeometry=true&outSR=3857&orderByFields=source_id\\+ASC&resultRecordCount=1000"
