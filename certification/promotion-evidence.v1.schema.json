{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/promotion-evidence.v1.schema.json",
  "title": "Honua immutable promotion evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platformLabel",
    "rcTrainRunId",
    "lock",
    "strictTrains",
    "demoCanaries",
    "evidenceClasses",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "promotion-evidence.v1"
    },
    "platformLabel": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?-rc\\.[1-9][0-9]*$"
    },
    "rcTrainRunId": {
      "$ref": "#/$defs/runId"
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "burnStartedAt"
      ],
      "properties": {
        "path": {
          "const": "platform-lock.json"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "burnStartedAt": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "strictTrains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "demoCanaries": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "evidenceClasses": {
      "type": "object",
      "minProperties": 15,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "enum": [
          "nightly",
          "qualifying"
        ]
      },
      "required": [
        "build-test",
        "contract",
        "sbom",
        "security",
        "upgrade",
        "capacity-soak",
        "dr",
        "lambda-certification",
        "protocol-ledger",
        "deterministic-journey",
        "nightly-model-journey",
        "genuine-model-journey",
        "update-rollback",
        "esri-bundle",
        "cite"
      ],
      "properties": {
        "build-test": {
          "const": "nightly"
        },
        "contract": {
          "const": "nightly"
        },
        "sbom": {
          "const": "nightly"
        },
        "security": {
          "const": "nightly"
        },
        "upgrade": {
          "const": "nightly"
        },
        "capacity-soak": {
          "const": "nightly"
        },
        "dr": {
          "const": "nightly"
        },
        "lambda-certification": {
          "const": "nightly"
        },
        "protocol-ledger": {
          "const": "nightly"
        },
        "deterministic-journey": {
          "const": "nightly"
        },
        "nightly-model-journey": {
          "const": "nightly"
        },
        "genuine-model-journey": {
          "const": "qualifying"
        },
        "update-rollback": {
          "const": "qualifying"
        },
        "esri-bundle": {
          "const": "qualifying"
        },
        "cite": {
          "const": "qualifying"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 15,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "completedAt",
        "status",
        "lockDigest"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "completedAt": {
          "$ref": "#/$defs/time"
        },
        "status": {
          "const": "pass"
        },
        "lockDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "runId",
        "completedAt",
        "status",
        "lockDigest"
      ],
      "properties": {
        "class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "completedAt": {
          "$ref": "#/$defs/time"
        },
        "status": {
          "const": "pass"
        },
        "lockDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
