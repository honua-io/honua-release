{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/promotion-evidence.v1.schema.json",
  "title": "Honua immutable promotion evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platformLabel",
    "rcTrainRunId",
    "lock",
    "strictTrains",
    "demoCanaries",
    "evidenceClasses",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "promotion-evidence.v1"
    },
    "platformLabel": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?-rc\\.[1-9][0-9]*$"
    },
    "rcTrainRunId": {
      "$ref": "#/$defs/runId"
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "burnStartedAt"
      ],
      "properties": {
        "path": {
          "const": "platform-lock.json"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "burnStartedAt": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "strictTrains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "demoCanaries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "evidenceClasses": {
      "type": "object",
      "minProperties": 15,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "enum": [
          "nightly",
          "qualifying"
        ]
      },
      "required": [
        "build-test",
        "contract",
        "sbom",
        "security",
        "upgrade",
        "capacity-soak",
        "dr",
        "lambda-certification",
        "protocol-ledger",
        "deterministic-journey",
        "nightly-model-journey",
        "executable-docs",
        "genuine-model-journey",
        "update-rollback",
        "esri-bundle",
        "cite"
      ],
      "properties": {
        "build-test": {
          "const": "nightly"
        },
        "contract": {
          "const": "nightly"
        },
        "sbom": {
          "const": "nightly"
        },
        "security": {
          "const": "nightly"
        },
        "upgrade": {
          "const": "nightly"
        },
        "capacity-soak": {
          "const": "nightly"
        },
        "dr": {
          "const": "nightly"
        },
        "lambda-certification": {
          "const": "nightly"
        },
        "protocol-ledger": {
          "const": "nightly"
        },
        "deterministic-journey": {
          "const": "nightly"
        },
        "nightly-model-journey": {
          "const": "nightly"
        },
        "executable-docs": {
          "const": "nightly"
        },
        "genuine-model-journey": {
          "const": "qualifying"
        },
        "update-rollback": {
          "const": "qualifying"
        },
        "esri-bundle": {
          "const": "qualifying"
        },
        "cite": {
          "const": "qualifying"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 15,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "profile": {
      "enum": [
        "ga",
        "patch"
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "lockDigest",
        "releaseTag"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "lockDigest": {
          "$ref": "#/$defs/digest"
        },
        "releaseTag": {
          "type": "string",
          "pattern": "^honua-[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "completedAt",
        "status",
        "lockDigest"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "completedAt": {
          "$ref": "#/$defs/time"
        },
        "status": {
          "const": "pass"
        },
        "lockDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "runId",
        "completedAt",
        "status",
        "lockDigest"
      ],
      "properties": {
        "class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "completedAt": {
          "$ref": "#/$defs/time"
        },
        "status": {
          "const": "pass"
        },
        "lockDigest": {
          "$ref": "#/$defs/digest"
        },
        "reusedComponents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "updateRollbackCell": {
      "type": "object",
      "required": [
        "cell",
        "updateStatus",
        "rollbackStatus",
        "actuator",
        "fromDigest",
        "toDigest",
        "schemaBoundary",
        "executionOutcome",
        "functionalGpExecuted",
        "cleanup",
        "cost",
        "prior",
        "candidate",
        "observations",
        "updateOperation",
        "rollbackOperation"
      ],
      "properties": {
        "cell": {
          "enum": [
            "aws-ecs/redis-off",
            "aws-ecs/redis-on",
            "aws-serverless/redis-off",
            "aws-serverless/redis-on"
          ]
        },
        "updateStatus": {
          "const": "pass"
        },
        "rollbackStatus": {
          "const": "pass"
        },
        "actuator": {
          "enum": [
            "terraform-exact-apply",
            "honua-aws-ecs-alb",
            "honua-gitops-aws-lambda"
          ]
        },
        "fromDigest": {
          "$ref": "#/$defs/digest"
        },
        "toDigest": {
          "$ref": "#/$defs/digest"
        },
        "inFlightJob": {
          "type": "object",
          "required": [
            "jobId",
            "initialState",
            "terminalStates",
            "attemptCount",
            "executionEvents",
            "output"
          ],
          "properties": {
            "jobId": {
              "type": "string",
              "pattern": "\\S"
            },
            "initialState": {
              "const": "running"
            },
            "terminalStates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "const": "succeeded"
              },
              "maxItems": 1
            },
            "attemptCount": {
              "const": 1
            },
            "executionEvents": {
              "type": "object",
              "required": [
                "started",
                "completed"
              ],
              "properties": {
                "started": {
                  "const": 1
                },
                "completed": {
                  "const": 1
                }
              }
            },
            "output": {
              "type": "object",
              "required": [
                "sha256",
                "fixtureSha256",
                "oracle"
              ],
              "properties": {
                "sha256": {
                  "$ref": "#/$defs/digest"
                },
                "fixtureSha256": {
                  "$ref": "#/$defs/digest"
                },
                "oracle": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "schemaBoundary": {
          "type": "object",
          "required": [
            "status",
            "outcome",
            "schemaVersion",
            "imageDigest"
          ],
          "properties": {
            "status": {
              "const": "pass"
            },
            "outcome": {
              "enum": [
                "serving",
                "refused-cleanly"
              ]
            },
            "schemaVersion": {
              "type": "string",
              "pattern": "\\S"
            },
            "imageDigest": {
              "$ref": "#/$defs/digest"
            },
            "reasonCode": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "refused-cleanly"
                  }
                }
              },
              "then": {
                "required": [
                  "reasonCode"
                ]
              }
            }
          ]
        },
        "executionOutcome": {
          "enum": [
            "succeeded",
            "refused"
          ]
        },
        "functionalGpExecuted": {
          "type": "boolean"
        },
        "cleanup": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "pass"
            }
          }
        },
        "cost": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "pass"
            }
          }
        },
        "jobBeforeUpdate": {
          "type": "object",
          "required": [
            "jobId",
            "state",
            "attemptCount"
          ],
          "properties": {
            "jobId": {
              "type": "string",
              "pattern": "\\S"
            },
            "state": {
              "const": "running"
            },
            "attemptCount": {
              "const": 1
            }
          }
        },
        "jobAfterUpdate": {
          "type": "object",
          "required": [
            "jobId",
            "state",
            "attemptCount"
          ],
          "properties": {
            "jobId": {
              "type": "string",
              "pattern": "\\S"
            },
            "state": {
              "const": "running"
            },
            "attemptCount": {
              "const": 1
            }
          }
        },
        "jobBeforeRollback": {
          "type": "object",
          "required": [
            "jobId",
            "state",
            "attemptCount"
          ],
          "properties": {
            "jobId": {
              "type": "string",
              "pattern": "\\S"
            },
            "state": {
              "const": "running"
            },
            "attemptCount": {
              "const": 1
            }
          }
        },
        "jobAfterRollback": {
          "type": "object",
          "required": [
            "jobId",
            "state",
            "attemptCount"
          ],
          "properties": {
            "jobId": {
              "type": "string",
              "pattern": "\\S"
            },
            "state": {
              "const": "running"
            },
            "attemptCount": {
              "const": 1
            }
          }
        },
        "refusals": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "outcome",
              "functionalGpExecuted",
              "code",
              "capability",
              "missingDependency"
            ],
            "properties": {
              "status": {
                "const": "pass"
              },
              "outcome": {
                "const": "refused"
              },
              "functionalGpExecuted": {
                "const": false
              },
              "code": {
                "const": "dependency-unavailable"
              },
              "capability": {
                "const": "jobs.runner"
              },
              "missingDependency": {
                "const": "redis"
              }
            }
          }
        },
        "rollbackInFlightJob": {
          "$ref": "#/$defs/updateRollbackCell/properties/inFlightJob"
        },
        "prior": {
          "$ref": "#/$defs/updateRollbackRelease"
        },
        "candidate": {
          "$ref": "#/$defs/updateRollbackRelease"
        },
        "observations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/updateRollbackObservation"
          }
        },
        "updateOperation": {
          "oneOf": [
            {
              "$ref": "#/$defs/updateRollbackNativeOperation"
            },
            {
              "$ref": "#/$defs/updateRollbackTerraformOperation"
            }
          ]
        },
        "rollbackOperation": {
          "oneOf": [
            {
              "$ref": "#/$defs/updateRollbackNativeOperation"
            },
            {
              "$ref": "#/$defs/updateRollbackTerraformOperation"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cell": {
                "const": "aws-ecs/redis-off"
              }
            }
          },
          "then": {
            "properties": {
              "actuator": {
                "const": "terraform-exact-apply"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cell": {
                "const": "aws-ecs/redis-on"
              }
            }
          },
          "then": {
            "properties": {
              "actuator": {
                "const": "honua-aws-ecs-alb"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cell": {
                "const": "aws-serverless/redis-off"
              }
            }
          },
          "then": {
            "properties": {
              "actuator": {
                "const": "honua-gitops-aws-lambda"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cell": {
                "const": "aws-serverless/redis-on"
              }
            }
          },
          "then": {
            "properties": {
              "actuator": {
                "const": "honua-gitops-aws-lambda"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cell": {
                "enum": [
                  "aws-ecs/redis-on",
                  "aws-serverless/redis-on"
                ]
              }
            }
          },
          "then": {
            "required": [
              "inFlightJob",
              "jobBeforeUpdate",
              "jobAfterUpdate",
              "jobBeforeRollback",
              "jobAfterRollback",
              "rollbackInFlightJob"
            ],
            "properties": {
              "executionOutcome": {
                "const": "succeeded"
              },
              "functionalGpExecuted": {
                "const": true
              }
            }
          },
          "else": {
            "required": [
              "refusals"
            ],
            "properties": {
              "executionOutcome": {
                "const": "refused"
              },
              "functionalGpExecuted": {
                "const": false
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "inFlightJob"
                  ]
                },
                {
                  "required": [
                    "jobBeforeUpdate"
                  ]
                },
                {
                  "required": [
                    "jobAfterUpdate"
                  ]
                },
                {
                  "required": [
                    "jobBeforeRollback"
                  ]
                },
                {
                  "required": [
                    "jobAfterRollback"
                  ]
                },
                {
                  "required": [
                    "rollbackInFlightJob"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "actuator": {
                "const": "terraform-exact-apply"
              }
            }
          },
          "then": {
            "properties": {
              "updateOperation": {
                "$ref": "#/$defs/updateRollbackTerraformOperation"
              },
              "rollbackOperation": {
                "$ref": "#/$defs/updateRollbackTerraformOperation"
              }
            }
          },
          "else": {
            "properties": {
              "updateOperation": {
                "$ref": "#/$defs/updateRollbackNativeOperation"
              },
              "rollbackOperation": {
                "$ref": "#/$defs/updateRollbackNativeOperation"
              }
            }
          }
        }
      ]
    },
    "updateRollbackReceipt": {
      "description": "Actual four-cell AWS update/rollback proof. Redis-on requires a real job running before and after each switch, exactly one successful execution per transition and stable independently verified output. Redis-off requires three explicit typed Redis refusals and never gets GP completion credit. Every cell retains exact image/schema/cleanup/cost proof. Rehearsal records have no qualifying evidence class or signed-lock credit.",
      "type": "object",
      "required": [
        "class",
        "lockDigest",
        "fromLockDigest",
        "toLockDigest",
        "updateStatus",
        "rollbackStatus",
        "cells",
        "runId",
        "completedAt",
        "status",
        "kind",
        "freshUntil"
      ],
      "properties": {
        "class": {
          "const": "update-rollback"
        },
        "lockDigest": {
          "$ref": "#/$defs/digest"
        },
        "fromLockDigest": {
          "$ref": "#/$defs/digest"
        },
        "toLockDigest": {
          "$ref": "#/$defs/digest"
        },
        "updateStatus": {
          "const": "pass"
        },
        "rollbackStatus": {
          "const": "pass"
        },
        "cells": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/updateRollbackCell"
          }
        },
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "completedAt": {
          "$ref": "#/$defs/time"
        },
        "status": {
          "const": "pass"
        },
        "kind": {
          "const": "qualifying"
        },
        "freshUntil": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "updateRollbackRelease": {
      "type": "object",
      "required": [
        "manifestDigest",
        "sourceRevision",
        "schemaVersion",
        "imageDigest",
        "lambdaImageDigest"
      ],
      "properties": {
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "\\S"
        },
        "imageDigest": {
          "$ref": "#/$defs/digest"
        },
        "lambdaImageDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "updateRollbackObservation": {
      "type": "object",
      "required": [
        "phase",
        "observedAt",
        "sourceRevision",
        "native",
        "schemaJournal",
        "servingFixture"
      ],
      "properties": {
        "phase": {
          "enum": [
            "baseline",
            "candidate",
            "rollback"
          ]
        },
        "observedAt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "native": {
          "type": "object",
          "required": [
            "kind",
            "imageDigest"
          ],
          "properties": {
            "kind": {
              "enum": [
                "ecs-native-routing",
                "lambda-alias"
              ]
            },
            "imageDigest": {
              "$ref": "#/$defs/digest"
            },
            "version": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "taskCount": {
              "type": "integer",
              "minimum": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "lambda-alias"
                  }
                }
              },
              "then": {
                "required": [
                  "version"
                ]
              },
              "else": {
                "required": [
                  "taskCount"
                ]
              }
            }
          ]
        },
        "schemaJournal": {
          "type": "object",
          "required": [
            "method",
            "pendingScripts",
            "extraScripts",
            "readyForCoordinatedDeploy",
            "candidateImageDigest"
          ],
          "properties": {
            "method": {
              "const": "live-bidirectional-migration-plan"
            },
            "pendingScripts": {
              "const": 0
            },
            "extraScripts": {
              "const": 0
            },
            "readyForCoordinatedDeploy": {
              "const": true
            },
            "candidateImageDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "servingFixture": {
          "type": "object",
          "required": [
            "serviceId",
            "layerId",
            "seedManifestSha256",
            "seedScriptSha256",
            "seedSqlSha256",
            "expectedFeaturesSha256"
          ],
          "properties": {
            "serviceId": {
              "const": "e2e"
            },
            "layerId": {
              "type": "integer",
              "minimum": 0
            },
            "seedManifestSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "seedScriptSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "seedSqlSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "expectedFeaturesSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "updateRollbackNativeOperation": {
      "type": "object",
      "required": [
        "operationId",
        "status",
        "observedRevision",
        "providerOperationIdSha256"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "Succeeded",
            "Observing",
            "Protected",
            "Reconciling",
            "RolledBack"
          ]
        },
        "observedRevision": {
          "type": "string",
          "pattern": "\\S"
        },
        "providerOperationIdSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "updateRollbackTerraformOperation": {
      "type": "object",
      "required": [
        "actuator",
        "status",
        "planSha256",
        "imageDigest"
      ],
      "properties": {
        "actuator": {
          "const": "terraform-exact-apply"
        },
        "status": {
          "const": "applied"
        },
        "planSha256": {
          "$ref": "#/$defs/digest"
        },
        "imageDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "profile"
        ],
        "properties": {
          "profile": {
            "const": "patch"
          }
        }
      },
      "then": {
        "required": [
          "baseline"
        ],
        "properties": {
          "demoCanaries": {
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "baseline"
          ]
        },
        "properties": {
          "demoCanaries": {
            "minItems": 7,
            "maxItems": 7
          },
