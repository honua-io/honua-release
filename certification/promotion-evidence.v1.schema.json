{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/promotion-evidence.v1.schema.json",
  "title": "Honua immutable promotion evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platformLabel",
    "rcTrainRunId",
    "lock",
    "strictTrains",
    "demoCanaries",
    "evidenceClasses",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "promotion-evidence.v1"
    },
    "platformLabel": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?-rc\\.[1-9][0-9]*$"
    },
    "rcTrainRunId": {
      "$ref": "#/$defs/runId"
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "burnStartedAt"
      ],
      "properties": {
        "path": {
          "const": "platform-lock.json"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "burnStartedAt": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "strictTrains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "demoCanaries": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "evidenceClasses": {
      "type": "object",
      "minProperties": 15,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "enum": [
          "nightly",
          "qualifying"
        ]
      },
      "required": [
        "build-test",
        "contract",
        "sbom",
        "security",
        "upgrade",
        "capacity-soak",
        "dr",
        "lambda-certification",
        "protocol-ledger",
        "deterministic-journey",
        "nightly-model-journey",
        "executable-docs",
        "genuine-model-journey",
        "update-rollback",
        "esri-bundle",
        "cite"
      ],
      "properties": {
        "build-test": {
          "const": "nightly"
        },
        "contract": {
          "const": "nightly"
        },
        "sbom": {
          "const": "nightly"
        },
        "security": {
          "const": "nightly"
        },
        "upgrade": {
          "const": "nightly"
        },
        "capacity-soak": {
          "const": "nightly"
        },
        "dr": {
          "const": "nightly"
        },
        "lambda-certification": {
          "const": "nightly"
        },
        "protocol-ledger": {
          "const": "nightly"
        },
        "deterministic-journey": {
          "const": "nightly"
        },
        "nightly-model-journey": {
          "const": "nightly"
        },
        "executable-docs": {
          "const": "nightly"
        },
        "genuine-model-journey": {
          "const": "qualifying"
        },
        "update-rollback": {
          "const": "qualifying"
        },
        "esri-bundle": {
          "const": "qualifying"
        },
        "cite": {
          "const": "qualifying"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 15,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "completedAt",
        "status",
        "lockDigest"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "completedAt": {
          "$ref": "#/$defs/time"
        },
        "status": {
          "const": "pass"
        },
        "lockDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "runId",
        "completedAt",
        "status",
        "lockDigest"
      ],
      "properties": {
        "class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "completedAt": {
          "$ref": "#/$defs/time"
        },
        "status": {
          "const": "pass"
        },
        "lockDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "updateRollbackCell": {
      "type": "object",
      "required": [
        "cell",
        "updateStatus",
        "rollbackStatus",
        "actuator",
        "fromDigest",
        "toDigest",
        "schemaBoundary",
        "executionOutcome",
        "functionalGpExecuted",
        "cleanup",
        "cost"
      ],
      "properties": {
        "cell": {
          "enum": [
            "aws-ecs/redis-off",
            "aws-ecs/redis-on",
            "aws-serverless/redis-off",
            "aws-serverless/redis-on"
          ]
        },
        "updateStatus": {
          "const": "pass"
        },
        "rollbackStatus": {
          "const": "pass"
        },
        "actuator": {
          "enum": [
            "terraform-exact-apply",
            "honua-aws-ecs-alb",
            "honua-gitops-aws-lambda"
          ]
        },
        "fromDigest": {
          "$ref": "#/$defs/digest"
        },
        "toDigest": {
          "$ref": "#/$defs/digest"
        },
        "inFlightJob": {
          "type": "object",
          "required": [
            "jobId",
            "initialState",
            "terminalStates",
            "attemptCount",
            "executionEvents",
            "output"
          ],
          "properties": {
            "jobId": {
              "type": "string",
              "pattern": "\\S"
            },
            "initialState": {
              "const": "running"
            },
            "terminalStates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "const": "succeeded"
              },
              "maxItems": 1
            },
            "attemptCount": {
              "const": 1
            },
            "executionEvents": {
              "type": "object",
              "required": [
                "started",
                "completed"
              ],
              "properties": {
                "started": {
                  "const": 1
                },
                "completed": {
                  "const": 1
                }
              }
            },
            "output": {
              "type": "object",
              "required": [
                "sha256",
                "fixtureSha256",
                "oracle"
              ],
              "properties": {
                "sha256": {
                  "$ref": "#/$defs/digest"
                },
                "fixtureSha256": {
                  "$ref": "#/$defs/digest"
                },
                "oracle": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "schemaBoundary": {
          "type": "object",
          "required": [
            "status",
            "outcome",
            "schemaVersion",
            "imageDigest"
          ],
          "properties": {
            "status": {
              "const": "pass"
            },
            "outcome": {
              "enum": [
                "serving",
                "refused-cleanly"
              ]
            },
            "schemaVersion": {
              "type": "string",
              "pattern": "\\S"
            },
            "imageDigest": {
              "$ref": "#/$defs/digest"
            },
            "reasonCode": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "refused-cleanly"
                  }
                }
              },
              "then": {
                "required": [
                  "reasonCode"
                ]
              }
            }
          ]
        },
        "executionOutcome": {
          "enum": [
            "succeeded",
            "refused"
          ]
        },
        "functionalGpExecuted": {
          "type": "boolean"
        },
        "cleanup": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "pass"
            }
          }
        },
        "cost": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "pass"
            }
          }
        },
        "jobBeforeUpdate": {
          "type": "object",
          "required": [
            "jobId",
            "state",
            "attemptCount"
          ],
          "properties": {
            "jobId": {
              "type": "string",
              "pattern": "\\S"
            },
            "state": {
              "const": "running"
            },
            "attemptCount": {
              "const": 1
            }
          }
        },
        "jobAfterUpdate": {
          "type": "object",
          "required": [
            "jobId",
            "state",
            "attemptCount"
          ],
          "properties": {
            "jobId": {
              "type": "string",
              "pattern": "\\S"
            },
            "state": {
              "const": "running"
            },
            "attemptCount": {
              "const": 1
            }
          }
        },
        "jobBeforeRollback": {
          "type": "object",
          "required": [
            "jobId",
            "state",
            "attemptCount"
          ],
          "properties": {
            "jobId": {
              "type": "string",
              "pattern": "\\S"
            },
            "state": {
              "const": "running"
            },
            "attemptCount": {
              "const": 1
            }
          }
        },
        "jobAfterRollback": {
          "type": "object",
          "required": [
            "jobId",
            "state",
            "attemptCount"
          ],
          "properties": {
            "jobId": {
              "type": "string",
              "pattern": "\\S"
            },
            "state": {
              "const": "running"
            },
            "attemptCount": {
              "const": 1
            }
          }
        },
        "refusals": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "outcome",
              "functionalGpExecuted",
              "code",
              "capability",
              "missingDependency"
            ],
            "properties": {
              "status": {
                "const": "pass"
              },
              "outcome": {
                "const": "refused"
              },
              "functionalGpExecuted": {
                "const": false
              },
              "code": {
                "const": "dependency-unavailable"
              },
              "capability": {
                "const": "jobs.runner"
              },
              "missingDependency": {
                "const": "redis"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cell": {
                "const": "aws-ecs/redis-off"
              }
            }
          },
          "then": {
            "properties": {
              "actuator": {
                "const": "terraform-exact-apply"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cell": {
                "const": "aws-ecs/redis-on"
              }
            }
          },
          "then": {
            "properties": {
              "actuator": {
                "const": "honua-aws-ecs-alb"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cell": {
                "const": "aws-serverless/redis-off"
              }
            }
          },
          "then": {
            "properties": {
              "actuator": {
                "const": "honua-gitops-aws-lambda"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cell": {
                "const": "aws-serverless/redis-on"
              }
            }
          },
          "then": {
            "properties": {
              "actuator": {
                "const": "honua-gitops-aws-lambda"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cell": {
                "enum": [
                  "aws-ecs/redis-on",
                  "aws-serverless/redis-on"
                ]
              }
            }
          },
          "then": {
            "required": [
              "inFlightJob",
              "jobBeforeUpdate",
              "jobAfterUpdate",
              "jobBeforeRollback",
              "jobAfterRollback"
            ],
            "properties": {
              "executionOutcome": {
                "const": "succeeded"
              },
              "functionalGpExecuted": {
                "const": true
              }
            }
          },
          "else": {
            "required": [
              "refusals"
            ],
            "properties": {
              "executionOutcome": {
                "const": "refused"
              },
              "functionalGpExecuted": {
                "const": false
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "inFlightJob"
                  ]
                },
                {
                  "required": [
                    "jobBeforeUpdate"
                  ]
                },
                {
                  "required": [
                    "jobAfterUpdate"
                  ]
                },
                {
                  "required": [
                    "jobBeforeRollback"
                  ]
                },
                {
                  "required": [
                    "jobAfterRollback"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "updateRollbackReceipt": {
      "description": "Actual four-cell AWS update/rollback proof. Redis-on requires the same real job running before and after both switches, one successful execution and stable independently verified output. Redis-off requires three explicit typed Redis refusals and never gets GP completion credit. Every cell retains exact image/schema/cleanup/cost proof. Rehearsal records have no qualifying evidence class or signed-lock credit.",
      "type": "object",
      "required": [
        "class",
        "lockDigest",
        "fromLockDigest",
        "toLockDigest",
        "updateStatus",
        "rollbackStatus",
        "cells",
        "runId",
        "completedAt",
        "status",
        "kind",
        "freshUntil"
      ],
      "properties": {
        "class": {
          "const": "update-rollback"
        },
        "lockDigest": {
          "$ref": "#/$defs/digest"
        },
        "fromLockDigest": {
          "$ref": "#/$defs/digest"
        },
        "toLockDigest": {
          "$ref": "#/$defs/digest"
        },
        "updateStatus": {
          "const": "pass"
        },
        "rollbackStatus": {
          "const": "pass"
        },
        "cells": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/updateRollbackCell"
          }
        },
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "completedAt": {
          "$ref": "#/$defs/time"
        },
        "status": {
          "const": "pass"
        },
        "kind": {
          "const": "qualifying"
        },
        "freshUntil": {
          "$ref": "#/$defs/time"
        }
      }
    }
  }
}
