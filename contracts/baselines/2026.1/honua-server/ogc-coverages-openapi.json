    "/collections/{collectionId}/coverage": {
      "get": {
        "parameters": [
          {
            "$ref": "#/components/parameters/CollectionId"
          },
          {
            "description": "Spatial subset as xmin,ymin,xmax,ymax. Coordinates are CRS84 unless bbox-crs is supplied; geographic antimeridian crossings are represented with east/west clip polygons.",
            "in": "query",
            "name": "bbox",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "CRS identifier for bbox coordinates. Must resolve to one of the collection's advertised CRS identifiers.",
            "in": "query",
            "name": "bbox-crs",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Output CRS identifier. Must resolve to one of the collection's advertised CRS identifiers.",
            "in": "query",
            "name": "crs",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Comma-separated band fields, for example band_1,band_3.",
            "in": "query",
            "name": "properties",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Positive native/storage CRS pixel size as one value or width,height. Maps to RasterQuery.PixelSize before output reprojection. The derived output must not exceed 8192 pixels on either axis, checked in storage CRS against the requested bbox when supplied and otherwise against coverage extent or native grid metadata.",
            "in": "query",
            "name": "resolution",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Positive multiplier for the native pixel size. The derived output must not exceed 8192 pixels on either axis, checked in storage CRS against the requested bbox when supplied and otherwise against coverage extent or native grid metadata.",
            "in": "query",
            "name": "scale-factor",
            "schema": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          {
            "description": "Output size as width,height or axis-size pairs such as x(512),y(512), with each axis from 1 through 8192 pixels.",
            "in": "query",
            "name": "scale-size",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Coverage encoding. Defaults to GeoTIFF when no explicit format or Accept header is supplied.",
            "in": "query",
            "name": "f",
            "schema": {
              "enum": [
                "geotiff",
                "tiff",
                "tif",
                "image/tiff",
                "png",
                "image/png"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/png": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "image/tiff": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Coverage payload",
            "headers": {
              "Content-Bbox": {
                "description": "Result coverage bounding box.",
                "schema": {
                  "type": "string"
                }
              },
              "Content-Crs": {
                "description": "Result CRS URI-reference when the result SRID is not 4326.",
                "schema": {
                  "type": "string"
                }
              },
              "Link": {
                "description": "Self and alternate coverage payload links for GeoTIFF and PNG representations. Alternate links preserve non-f query parameters from the request and set f for the target encoding.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "summary": "Get coverage data"
      }
    },
