    "x-honua-cite-compliance": {
      "authoritativeSource": "docs/cite-status.md",
      "evidenceRuns": {
        "aggregate": "https://github.com/honua-io/honua-server/actions/runs/33205558805",
        "wfs20Basic": "https://github.com/honua-io/honua-server/actions/runs/33583116921"
      },
      "lastEvidenceRun": "2026-09-02",
      "summary": "OGC API Processes does not yet have a published ETS; the surrounding Honua OGC stack passes 1138/1138 across 14 conformance suites."
    }
  },
