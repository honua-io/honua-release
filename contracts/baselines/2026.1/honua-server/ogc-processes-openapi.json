{
  "components": {
    "parameters": {
      "fMetadata": {
        "description": "Metadata response format.",
        "in": "query",
        "name": "f",
        "schema": {
          "enum": [
            "json",
            "html"
          ],
          "type": "string"
        }
      },
      "fOpenApi": {
        "description": "OpenAPI document response format.",
        "in": "query",
        "name": "f",
        "schema": {
          "enum": [
            "json"
          ],
          "type": "string"
        }
      }
    },
    "schemas": {
      "AnalysisPlan": {
        "description": "Analysis plan with steps, inputs, and output expectations.",
        "properties": {
          "outputs": {
            "description": "Desired output artifact kinds.",
            "items": {
              "enum": [
                "scalar",
                "featureLayer",
                "table",
                "raster",
                "file",
                "report",
                "map",
                "appBundle"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "planId": {
            "description": "Unique identifier for the analysis plan.",
            "minLength": 1,
            "type": "string"
          },
          "steps": {
            "description": "Ordered list of processing steps.",
            "items": {
              "$ref": "#/components/schemas/PlanStep"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "planId",
          "steps"
        ],
        "type": "object"
      },
      "ConformanceDeclaration": {
        "properties": {
          "conformsTo": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Exception": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Execute": {
        "properties": {
          "inputs": {
            "additionalProperties": true,
            "description": "Inputs for the selected process. The canonical analysis process uses plan; direct processes use their advertised input identifiers and accept bare values, qualified values, or href links. Authorization selectors require inline values or data URIs before external input downloads.",
            "properties": {
              "plan": {
                "$ref": "#/components/schemas/AnalysisPlan"
              }
            },
            "type": "object"
          },
          "outputs": {
            "additionalProperties": {
              "additionalProperties": false,
              "properties": {
                "transmissionMode": {
                  "enum": [
                    "value"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            },
            "description": "Optional output selection keyed by advertised output identifier.",
            "type": "object"
          },
          "response": {
            "default": "document",
            "description": "Response mode for catalog processes. 'raw' returns the native representation for synchronous single-value executions and from the results endpoint for asynchronous jobs. Multiple raw outputs use multipart/related. The canonical honua-geoprocessing plan process requires document mode.",
            "enum": [
              "document",
              "raw"
            ],
            "type": "string"
          }
        },
        "required": [
          "inputs"
        ],
        "type": "object"
      },
      "InputDescription": {
        "properties": {
          "description": {
            "type": "string"
          },
          "minOccurs": {
            "minimum": 0,
            "type": "integer"
          },
          "schema": {
            "$ref": "#/components/schemas/ProcessIoSchema"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "JobList": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/StatusInfo"
            },
            "type": "array"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "LandingPage": {
        "properties": {
          "description": {
            "type": "string"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Link": {
        "properties": {
          "href": {
            "type": "string"
          },
          "rel": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "href"
        ],
        "type": "object"
      },
      "OutputDescription": {
        "properties": {
          "description": {
            "type": "string"
          },
          "schema": {
            "$ref": "#/components/schemas/ProcessIoSchema"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "PlanStep": {
        "description": "Single processing step in an analysis plan.",
        "properties": {
          "dependsOn": {
            "description": "Step IDs this step depends on.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "inputs": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Step input parameters as key-value string pairs.",
            "type": "object"
          },
          "kind": {
            "description": "Type of processing operation.",
            "enum": [
              "queryFeatures",
              "geoprocess",
              "aggregate",
              "renderMap",
              "export"
            ],
            "type": "string"
          },
          "processId": {
            "description": "Optional canonical process identifier for this step.",
            "type": "string"
          },
          "stepId": {
            "description": "Unique identifier for this step.",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "ProcessDescription": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProcessSummary"
          },
          {
            "properties": {
              "inputs": {
                "additionalProperties": {
                  "$ref": "#/components/schemas/InputDescription"
                },
                "type": "object"
              },
              "outputs": {
                "additionalProperties": {
                  "$ref": "#/components/schemas/OutputDescription"
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        ]
      },
      "ProcessIoSchema": {
        "description": "Minimal JSON Schema fragment describing a process input or output value.",
        "properties": {
          "allOf": {
            "items": {
              "$ref": "#/components/schemas/ProcessIoSchema"
            },
            "type": "array"
          },
          "contentEncoding": {
            "description": "JSON Schema content encoding hint.",
            "type": "string"
          },
          "contentMediaType": {
            "description": "Content media type hint for complex inputs.",
            "type": "string"
          },
          "enum": {
            "description": "Enumerated string values accepted by the schema.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "format": {
            "description": "JSON Schema format keyword.",
            "type": "string"
          },
          "items": {
            "$ref": "#/components/schemas/ProcessIoSchema"
          },
          "maxItems": {
            "description": "Maximum number of items accepted by an array schema.",
            "minimum": 0,
            "type": "integer"
          },
          "maximum": {
            "description": "Inclusive upper bound for numeric values.",
            "type": "number"
          },
          "minItems": {
            "description": "Minimum number of items accepted by an array schema.",
            "minimum": 0,
            "type": "integer"
          },
          "minimum": {
            "description": "Inclusive lower bound for numeric values.",
            "type": "number"
          },
          "not": {
            "$ref": "#/components/schemas/ProcessIoSchema"
          },
          "oneOf": {
            "items": {
              "$ref": "#/components/schemas/ProcessIoSchema"
            },
            "type": "array"
          },
          "pattern": {
            "description": "JSON Schema regular-expression constraint for string values.",
            "type": "string"
          },
          "properties": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ProcessIoSchema"
            },
            "type": "object"
          },
          "required": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": {
            "description": "JSON Schema type (string, number, object, array, etc.).",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProcessList": {
        "properties": {
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "processes": {
            "items": {
              "$ref": "#/components/schemas/ProcessSummary"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ProcessSummary": {
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "jobControlOptions": {
            "items": {
              "enum": [
                "async-execute",
                "sync-execute",
                "dismiss"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "outputTransmission": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RawJsonValue": {
        "description": "An arbitrary JSON object, array, string, number, boolean, or null returned by raw-mode execution."
      },
      "Results": {
        "additionalProperties": true,
        "description": "Document-mode results map keyed by output identifier. Catalog outputs are inline values or qualified values carrying mediaType and optional base64 encoding; the canonical plan process has no declared outputs.",
        "type": "object"
      },
      "StatusInfo": {
        "properties": {
          "created": {
            "format": "date-time",
            "type": "string"
          },
          "jobID": {
            "type": "string"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "message": {
            "type": "string"
          },
          "processID": {
            "type": "string"
          },
          "progress": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "enum": [
              "accepted",
              "running",
              "successful",
              "failed",
              "dismissed"
            ],
            "type": "string"
          },
          "type": {
            "description": "Resource type discriminator. Always 'process' for OGC API Processes jobs.",
            "type": "string"
          },
          "updated": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "description": "Administrative API key used by protected OGC API Processes operations.",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "OGC API Processes adapter over the Honua canonical geoprocessing runtime.\n\nCompliance: OGC CITE 1138/1138 across 14 conformance suites; WFS 2.0 basic is 167/167 — see docs/cite-status.md and run 33583116921.",
    "title": "Honua OGC API Processes",
