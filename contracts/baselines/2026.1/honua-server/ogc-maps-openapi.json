{
  "components": {
    "parameters": {
      "bbox": {
        "description": "Bounding box as minX,minY,maxX,maxY in the bbox-crs coordinate reference system.",
        "in": "query",
        "name": "bbox",
        "schema": {
          "type": "string"
        }
      },
      "bboxCrs": {
        "description": "Coordinate reference system for bbox coordinates. Supports EPSG codes and OGC CRS URIs.",
        "in": "query",
        "name": "bbox-crs",
        "schema": {
          "type": "string"
        }
      },
      "collections": {
        "description": "Comma-separated collection identifiers to include in a dataset map request. When omitted, all accessible map-enabled collections are considered.",
        "in": "query",
        "name": "collections",
        "schema": {
          "type": "string"
        }
      },
      "crs": {
        "description": "Coordinate reference system for the rendered map response. Supports EPSG codes and OGC CRS URIs.",
        "in": "query",
        "name": "crs",
        "schema": {
          "type": "string"
        }
      },
      "datetime": {
        "description": "RFC 3339 instant or interval used to select temporal raster mosaic frames. Accepts a single instant (e.g. 2024-02-15T00:00:00Z), a closed interval (start/end), and half-open intervals (start/.., ../end). Honua selects the newest effective acquisition batch within the bounded range across the addressed collection or dataset, then applies bbox windowing and renders rasters from that batch only. Requires the raster.temporal-mosaic entitlement; inactive entitlements return 402 Payment Required.",
        "in": "query",
        "name": "datetime",
        "schema": {
          "type": "string"
        }
      },
      "f": {
        "description": "Short output image format. When omitted, HTTP Accept negotiation is used.",
        "in": "query",
        "name": "f",
        "schema": {
          "enum": [
            "png",
            "jpeg",
            "jpg",
            "tiff",
            "tif"
          ],
          "type": "string"
        }
      },
      "height": {
        "description": "Rendered image height in pixels.",
        "in": "query",
        "name": "height",
        "schema": {
          "maximum": 4096,
          "minimum": 1,
          "type": "integer"
        }
      },
      "quality": {
        "description": "Lossy compression quality for JPEG output.",
        "in": "query",
        "name": "quality",
        "schema": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "width": {
        "description": "Rendered image width in pixels.",
        "in": "query",
        "name": "width",
        "schema": {
          "maximum": 4096,
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "schemas": {
      "LandingPage": {
        "properties": {
          "description": {
            "type": "string"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "links"
        ],
        "type": "object"
      },
      "Link": {
        "properties": {
          "href": {
            "type": "string"
          },
          "rel": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "href"
        ],
        "type": "object"
      },
      "OgcMapsConformance": {
        "properties": {
          "conformsTo": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "conformsTo"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "correlationId": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "timestamp": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "type": "object"
      },
      "TileMatrixSetLimit": {
        "properties": {
          "maxTileCol": {
            "minimum": 0,
            "type": "integer"
          },
          "maxTileRow": {
            "minimum": 0,
            "type": "integer"
          },
          "minTileCol": {
            "minimum": 0,
            "type": "integer"
          },
          "minTileRow": {
            "minimum": 0,
            "type": "integer"
          },
          "tileMatrix": {
            "type": "string"
          }
        },
        "required": [
          "tileMatrix",
          "minTileRow",
          "maxTileRow",
          "minTileCol",
          "maxTileCol"
        ],
        "type": "object"
      },
      "TileSet": {
        "properties": {
          "crs": {
            "format": "uri",
            "type": "string"
          },
          "dataType": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "mediaTypes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tileMatrixSetId": {
            "type": "string"
          },
          "tileMatrixSetLimits": {
            "items": {
              "$ref": "#/components/schemas/TileMatrixSetLimit"
            },
            "type": "array"
          },
          "tileMatrixSetURI": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "dataType",
          "crs",
          "tileMatrixSetId",
          "links"
        ],
        "type": "object"
      },
      "TileSetItem": {
        "properties": {
          "crs": {
            "format": "uri",
            "type": "string"
          },
          "dataType": {
            "type": "string"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "tileMatrixSetId": {
            "type": "string"
          },
          "tileMatrixSetLimits": {
            "items": {
              "$ref": "#/components/schemas/TileMatrixSetLimit"
            },
            "type": "array"
          },
          "tileMatrixSetURI": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "dataType",
          "crs",
          "tileMatrixSetId",
          "links"
        ],
        "type": "object"
      },
      "TileSetsList": {
        "properties": {
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "tilesets": {
            "items": {
              "$ref": "#/components/schemas/TileSetItem"
            },
            "type": "array"
          }
        },
        "required": [
          "tilesets"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      },
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "OGC API Maps implementation for server-rendered imagery\n\nCompliance: OGC CITE 1117/1117 across 13 conformance suites â€” see docs/cite-status.md.",
    "title": "Honua OGC API Maps",
    "version": "1.0.0",
    "x-honua-cite-compliance": {
      "authoritativeSource": "docs/cite-status.md",
      "lastEvidenceRun": "2026-07-27",
      "suites": [
        {
          "passRate": "100%",
          "passed": 126,
          "profile": "default",
          "suite": "WMS 1.1.1",
          "total": 126
        },
        {
          "passRate": "100%",
          "passed": 213,
          "profile": "default",
          "suite": "WMS 1.3",
          "total": 213
        }
      ],
      "summary": "Map rendering is exercised through the classic WMS 1.1.1 and 1.3 ETS profiles, which pass 126/126 and 213/213 on trunk; full Honua suite is 1117/1117."
    }
  },
  "openapi": "3.0.3",
