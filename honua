#!/usr/bin/env python3
"""Customer entry point for the release compatibility tools."""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "tools"))

import compat_check
import release_inspect


def main():
    commands = {("release", "inspect"): release_inspect.main,
                ("compat", "check"): compat_check.main}
    command = commands.get(tuple(sys.argv[1:3]))
    if command is not None:
        return command(sys.argv[3:])
    parser = argparse.ArgumentParser(description=__doc__, usage="honua {release inspect | compat check} ...")
    parser.parse_args()
    parser.print_help()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
