{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/platform-lock.v1.schema.json",
  "title": "Honua platform lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["lockVersion", "platform", "sourceInputs", "components", "contentDigests", "fixtures", "sbom", "provenance", "notes"],
  "properties": {
    "lockVersion": {"const": "platform-lock.v1"},
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "supportTier"],
      "properties": {
        "id": {"type": "string", "pattern": "^honua-[0-9]{4}\\.[0-9]+(?:-rc\\.[1-9][0-9]*)?$"},
        "status": {"enum": ["draft", "rc", "released"]},
        "supportTier": {"type": "string", "minLength": 1}
      }
    },
    "sourceInputs": {
      "type": "object", "additionalProperties": false,
      "required": ["platformManifest", "compatibilityMatrix"],
      "properties": {
        "platformManifest": {"$ref": "#/$defs/inputIdentity"},
        "compatibilityMatrix": {"$ref": "#/$defs/inputIdentity"}
      }
    },
    "components": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/component"}
    },
    "contentDigests": {
      "type": "object", "additionalProperties": false,
      "required": ["geospatialMcp", "catalog", "okf"],
      "properties": {
        "geospatialMcp": {"$ref": "#/$defs/digest"},
        "catalog": {"$ref": "#/$defs/digest"},
        "okf": {"$ref": "#/$defs/digest"}
      }
    },
    "fixtures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
    "sbom": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRef"}},
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRef"}},
    "notes": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"$ref": "#/$defs/sha256"},
    "inputIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "sourceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$"},
        "revision": {"$ref": "#/$defs/gitRevision"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "evidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["component", "uri", "sha256"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "pattern": "^(https|oci)://"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "lifecycleStatus", "supportTier", "contractVersions", "schemaVersions", "artifacts"],
      "properties": {
        "source": {"$ref": "#/$defs/sourceRef"},
        "lifecycleStatus": {"enum": ["GA", "Preview", "Experimental", "Excluded"]},
        "supportTier": {"type": "string", "minLength": 1},
        "contractVersions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "schemaVersions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "coordinate", "version", "sourceRevision"],
      "properties": {
        "kind": {"enum": ["npm", "nuget", "wheel", "image", "oci-chart", "terraform", "other"]},
        "coordinate": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sourceRevision": {"$ref": "#/$defs/gitRevision"},
        "integrity": {"type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "digest": {"$ref": "#/$defs/sha256"},
        "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["amd64", "arm64"]}},
        "architectureDigests": {
          "type": "object", "additionalProperties": false,
          "properties": {"amd64": {"$ref": "#/$defs/sha256"}, "arm64": {"$ref": "#/$defs/sha256"}}
        },
        "awsFargateArchitectures": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "amd64": {"$ref": "#/$defs/architectureCompatibility"},
            "arm64": {"$ref": "#/$defs/architectureCompatibility"}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "npm"}}}, "then": {"required": ["integrity"]}},
        {"if": {"properties": {"kind": {"enum": ["nuget", "wheel"]}}}, "then": {"required": ["sha256"]}},
        {"if": {"properties": {"kind": {"enum": ["image", "oci-chart"]}}}, "then": {"required": ["digest", "architectures"]}},
        {"if": {"properties": {"kind": {"const": "image"}}}, "then": {"required": ["architectureDigests", "awsFargateArchitectures"]}}
      ]
    },
    "architectureCompatibility": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": {"enum": ["certified", "excluded"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "excluded"}}}, "then": {"required": ["reason"]}}
      ]
    }
  }
}
