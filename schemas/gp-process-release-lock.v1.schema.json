{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/gp-process-release-lock.v1.schema.json",
  "title": "GP process release lock v1",
  "description": "Immutable identity of one geoprocessing process release: the exact source, dependency lock, runtime image, workflow version, configuration references, targets, artifacts and validation receipts that a deployment activates. Generated once by `honua-gp-devkit release` (honua-server#6221); promoted and rolled back by digest, never rebuilt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "process", "source", "dependencyLock", "runtimeImage", "workflowVersion", "configurationReferences", "targets", "compatibility", "artifacts", "validation", "generatedAt"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "sizeBytes"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sizeBytes": {"type": "integer", "minimum": 1}
      }
    }
  },
  "properties": {
    "schema": {"const": "honua.gp-process-release-lock/v1"},
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "runtime", "entrypoint", "contract"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "version": {"$ref": "#/$defs/semver"},
        "runtime": {"enum": ["python", "dotnet"]},
        "entrypoint": {"type": "string", "minLength": 1},
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputSchemaSha256", "outputSchemaSha256"],
          "properties": {
            "inputSchemaSha256": {"$ref": "#/$defs/sha256"},
            "outputSchemaSha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sha", "descriptorPath"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "descriptorPath": {"type": "string", "pattern": "^[^ ]+\\.ya?ml$"}
      }
    },
    "dependencyLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtimeImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest"],
      "properties": {
        "reference": {"type": "string", "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "workflowVersion": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "configurationReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reference"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
          "reference": {
            "type": "string",
            "description": "A reference, never a value: the worker resolves it at execution time.",
            "pattern": "^(aws:secretsmanager:|azure:keyvault:|ref:)[^ ]+$"
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "workerImageDigest"],
        "properties": {
          "kind": {"enum": ["kubernetes-job", "aws-batch"]},
          "workerImageDigest": {"$ref": "#/$defs/sha256"},
          "chartVersion": {"$ref": "#/$defs/semver"},
          "jobDefinitionName": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"}
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverContractVersion"],
      "properties": {
        "serverContractVersion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"type": "integer", "minimum": 1},
            "maximum": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipts"],
      "properties": {
        "receipts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256", "status"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"},
              "status": {"const": "pass"}
            }
          }
        }
      }
    },
    "generatedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"}
  }
}
