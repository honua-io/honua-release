{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/gp-environment-state.v1.schema.json",
  "title": "GP environment state v1",
  "description": "What a deployment must know about an environment before it changes the active binding: the server execution-contract version it runs, the target kinds it can execute, and the binding version last observed. Until honua-server#6221 exposes the binding API this is a reviewed file in Git; afterwards the deploy workflow reads the live values and refuses when they disagree with the file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "environment", "serverContractVersion", "targets", "bindingVersion", "deploymentTooling"],
  "properties": {
    "schema": {"const": "honua.gp-environment-state/v1"},
    "environment": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
    "serverContractVersion": {"type": "integer", "minimum": 1},
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["kubernetes-job", "aws-batch"]}},
    "bindingVersion": {"type": "integer", "minimum": 0},
    "deploymentTooling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["helm", "aws-batch", "reference"]},
        "helmRelease": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,52}$"},
        "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "jobQueue": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"}
      }
    }
  }
}
