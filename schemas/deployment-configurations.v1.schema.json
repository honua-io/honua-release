{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retained image-matched deployment configurations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "images"
  ],
  "properties": {
    "schema": {
      "const": "honua.deployment-configurations/v1"
    },
    "images": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^ghcr\\.io/honua-io/honua-server@sha256:[a-f0-9]{64}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "release",
          "source",
          "rollbackMode",
          "configurations",
          "platformDigests"
        ],
        "properties": {
          "release": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "revision",
              "path"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "rollbackMode": {
            "enum": [
              "manual",
              "paired"
            ]
          },
          "platformDigests": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "propertyNames": {
              "pattern": "^linux/(amd64|arm64)$"
            }
          },
          "configurations": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "compose": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              },
              "helm": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
