{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/agent-e2e-receipt.v1.schema.json",
  "title": "Controller-attested agent E2E attempt receipt",
  "$comment": "Authenticity requires a separately verified controller attestation over the full receipt inventory. This schema does not authenticate self-reported JSON. See tools/agent_e2e_gate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptSchema", "campaignId", "caseId", "scenarioId", "variant", "target", "attempt", "mode", "packDigest", "corpusDigest", "promptDigest", "qualificationLockDigest", "componentBindingDigest", "modelId", "returnedModelId", "controller", "startedAt", "completedAt", "status", "failureAttribution", "namespace", "costs", "usage", "cleanup", "oracle", "transcript", "failureEvidence"],
  "properties": {
    "schemaVersion": {"const": 1},
    "receiptSchema": {"const": "agent-e2e-receipt.v1"},
    "campaignId": {"type": "string", "minLength": 1},
    "caseId": {"type": "string", "pattern": "^[PLB][0-9]{2}:[ABC]:(local-docker|aws-ecs-redis-on|aws-eks|aws-lambda|aws-batch)$"},
    "scenarioId": {"type": "string", "pattern": "^[PLB][0-9]{2}$"},
    "variant": {"enum": ["A", "B", "C"]},
    "target": {"enum": ["local-docker", "aws-ecs-redis-on", "aws-eks", "aws-lambda", "aws-batch"]},
    "attempt": {"type": "integer", "enum": [1, 2]},
    "mode": {"const": "genuine-model"},
    "packDigest": {"$ref": "#/$defs/digest"},
    "corpusDigest": {"$ref": "#/$defs/digest"},
    "promptDigest": {"$ref": "#/$defs/digest"},
    "qualificationLockDigest": {"$ref": "#/$defs/digest"},
    "componentBindingDigest": {"$ref": "#/$defs/digest"},
    "modelId": {"type": "string", "minLength": 1},
    "returnedModelId": {"type": "string", "minLength": 1},
    "controller": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "workflow", "sourceSha", "runId", "runAttempt"],
      "properties": {
        "repository": {"const": "honua-io/honua-release"},
        "workflow": {"type": "string", "pattern": "^\\.github/workflows/.+\\.ya?ml$"},
        "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "runId": {"type": "integer", "minimum": 1},
        "runAttempt": {"type": "integer", "minimum": 1}
      }
    },
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pass", "fail", "blocked"]},
    "failureAttribution": {"enum": [null, "infrastructure", "model", "product"]},
    "namespace": {"type": "string", "minLength": 1},
    "usage": {
      "type": "object", "additionalProperties": false, "required": ["modelTurns", "executedActions"],
      "properties": {"modelTurns": {"type": "integer", "minimum": 0}, "executedActions": {"type": "integer", "minimum": 0}}
    },
    "costs": {
      "type": "object", "additionalProperties": false,
      "required": ["modelUsd", "infrastructureUsd", "cleanupUsd", "cleanupReservedUsd"],
      "properties": {
        "modelUsd": {"type": "number", "minimum": 0},
        "infrastructureUsd": {"type": "number", "minimum": 0},
        "cleanupUsd": {"type": "number", "minimum": 0},
        "cleanupReservedUsd": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "cleanup": {
      "type": "object", "additionalProperties": false, "required": ["status", "evidence"],
      "properties": {"status": {"enum": ["pass", "fail", "blocked"]}, "evidence": {"$ref": "#/$defs/evidence"}}
    },
    "oracle": {"anyOf": [{"$ref": "#/$defs/evidence"}, {"type": "null"}]},
    "transcript": {"$ref": "#/$defs/evidence"},
    "failureEvidence": {"anyOf": [{"$ref": "#/$defs/evidence"}, {"type": "null"}]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}
    }
  }
}
