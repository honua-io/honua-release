{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/2026.1-evidence-map.schema.json",
  "title": "Honua 2026.1 GA evidence map",
  "type": "object",
  "required": [
    "schema",
    "packet",
    "contract",
    "rows",
    "coverageLimits"
  ],
  "properties": {
    "schema": {
      "const": "honua.release.2026.1-evidence-map/v1"
    },
    "packet": {
      "enum": [
        "part1",
        "part2"
      ]
    },
    "contract": {
      "type": "object",
      "required": [
        "source",
        "gaScope",
        "amendments"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "gaScope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "amendments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "coverageLimits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "row": {
      "type": "object",
      "required": [
        "id",
        "priority",
        "contract",
        "expected",
        "proof",
        "gaps",
        "disposition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(A|M|G|GP|I|R)-[0-9]{2}$"
        },
        "priority": {
          "enum": [
            "p0",
            "p1",
            "p2"
          ]
        },
        "contract": {
          "type": "object",
          "required": [
            "operation",
            "protocol",
            "supportedConfiguration",
            "edition",
            "principal"
          ],
          "properties": {
            "operation": {
              "type": "string",
              "minLength": 1
            },
            "protocol": {
              "type": "string",
              "minLength": 1
            },
            "supportedConfiguration": {
              "type": "string",
              "minLength": 1
            },
            "edition": {
              "type": "string",
              "minLength": 1
            },
            "principal": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "expected": {
          "type": "object",
          "required": [
            "result",
            "durableSideEffects",
            "failureBehaviour"
          ],
          "properties": {
            "result": {
              "type": "string",
              "minLength": 1
            },
            "durableSideEffects": {
              "type": "string",
              "minLength": 1
            },
            "failureBehaviour": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "proof": {
          "type": "object",
          "required": [
            "tests",
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "tests": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "object",
                "required": [
                  "file",
                  "name",
                  "fixture",
                  "executionLayer",
                  "candidateBoundReceipt"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fixture": {
                    "type": "string",
                    "minLength": 1
                  },
                  "executionLayer": {
                    "enum": [
                      "unit",
                      "api-integration",
                      "published-container-e2e",
                      "emulator",
                      "real-ecs"
                    ]
                  },
                  "candidateBoundReceipt": {
                    "type": "boolean"
                  },
                  "receipt": {
                    "type": "object",
                    "description": "Content-addressed candidate, fixture and behavior-result references. Consumers must retrieve and verify these artifacts; schema validation alone does not certify a candidate.",
                    "required": ["fixtureSha256", "resultSha256", "result"],
                    "anyOf": [
                      {"required": ["imageDigest"]},
                      {"required": ["lockSha256"]}
                    ],
                    "properties": {
                      "imageDigest": {"$ref": "#/$defs/sha256"},
                      "lockSha256": {"$ref": "#/$defs/sha256"},
                      "fixtureSha256": {"$ref": "#/$defs/sha256"},
                      "resultSha256": {"$ref": "#/$defs/sha256"},
                      "result": {"enum": ["pass", "fail", "skipped"]}
                    },
                    "additionalProperties": false
                  },
                  "authBypassed": {
                    "type": "boolean",
                    "description": "True when the fixture runs the server with HONUA_DEV_AUTH + HONUA_DEV_AUTH_ALLOW_BYPASS, so every request is authenticated as dev-bypass and the test proves nothing about authorization."
                  },
                  "store": {
                    "enum": [
                      "real-postgis",
                      "in-memory-fake",
                      "fake-object-store",
                      "real-object-store",
                      "n/a"
                    ],
                    "description": "What backs the data the test reads or writes."
                  },
                  "requiredCheck": {
                    "type": "boolean",
                    "description": "True when the test runs on the required per-PR gate; false when it runs only in the trailing matrix or a nightly/scheduled lane."
                  }
                },
                "additionalProperties": false,
                "if": {
                  "properties": {"candidateBoundReceipt": {"const": true}},
                  "required": ["candidateBoundReceipt"]
                },
                "then": {"required": ["receipt"]},
                "else": {"not": {"required": ["receipt"]}}
              }
            },
            "noProof": {
              "type": "boolean",
              "description": "True when the review found no executable test for the contract row."
            }
          },
          "additionalProperties": false,
          "oneOf": [
            {
              "properties": {
                "tests": {"maxItems": 0},
                "noProof": {"const": true}
              },
              "required": ["noProof"]
            },
            {
              "properties": {
                "tests": {"minItems": 1},
                "noProof": {"const": false}
              }
            }
          ]
        },
        "gaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "issueLinks": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "disposition": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "keep",
              "strengthen",
              "consolidate",
              "move",
              "remove",
              "not yet reviewed"
            ]
          }
        },
        "provesSeveral": {
          "type": "string",
          "description": "When one workflow proves several contract rows, names the other row ids it also covers."
        }
      },
      "additionalProperties": false
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
