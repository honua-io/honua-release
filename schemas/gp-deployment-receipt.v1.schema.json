{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honua.io/schemas/gp-deployment-receipt.v1.schema.json",
  "title": "GP deployment receipt v1",
  "description": "Immutable record of one deploy or rollback attempt for one process in one environment: what was asked, every preflight check and its verdict, the smoke result, and whether the binding changed. A refused or failed attempt gets a receipt too.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation", "environment", "process", "release", "previousRelease", "checks", "smoke", "binding", "outcome", "refusalReasons", "runningJobsRetainRelease", "scheduleReconciliation", "actor", "run", "startedAt", "finishedAt"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detail"],
      "properties": {"status": {"enum": ["pass", "fail", "skipped"]}, "detail": {"type": "string"}}
    },
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"}
  },
  "properties": {
    "schema": {"const": "honua.gp-deployment-receipt/v1"},
    "operation": {"enum": ["deploy", "rollback"]},
    "environment": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
    "process": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lockDigest", "version", "sourceSha", "runtimeImageDigest", "workerImageDigests", "artifactDigests"],
      "properties": {
        "lockDigest": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1},
        "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "runtimeImageDigest": {"$ref": "#/$defs/sha256"},
        "workerImageDigests": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "artifactDigests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}}
      }
    },
    "previousRelease": {
      "oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["lockDigest"], "properties": {"lockDigest": {"$ref": "#/$defs/sha256"}}}]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lockDigest", "artifactAvailability", "imageAvailability", "compatibility", "targets", "bindingVersion", "rollbackTarget"],
      "properties": {
        "lockDigest": {"$ref": "#/$defs/check"},
        "artifactAvailability": {"$ref": "#/$defs/check"},
        "imageAvailability": {"$ref": "#/$defs/check"},
        "compatibility": {"$ref": "#/$defs/check"},
        "targets": {"$ref": "#/$defs/check"},
        "bindingVersion": {"$ref": "#/$defs/check"},
        "rollbackTarget": {"$ref": "#/$defs/check"}
      }
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {"status": {"enum": ["pass", "fail", "skipped"]}, "evidence": {"type": "string"}}
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detail"],
      "properties": {
        "status": {"enum": ["activated", "unchanged", "pending-server-6221"]},
        "detail": {"type": "string"}
      }
    },
    "outcome": {"enum": ["activated", "refused", "failed", "reference-only"]},
    "refusalReasons": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+(:.*)?$"}},
    "runningJobsRetainRelease": {"const": true},
    "scheduleReconciliation": {"enum": ["not-required", "reconciled", "pending-server-6221"]},
    "actor": {"type": "string", "minLength": 1},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "id", "attempt", "url"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "id": {"type": "string", "pattern": "^[0-9]+$"},
        "attempt": {"type": "integer", "minimum": 1},
        "url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/actions/runs/[0-9]+$"}
      }
    },
    "startedAt": {"$ref": "#/$defs/timestamp"},
    "finishedAt": {"$ref": "#/$defs/timestamp"}
  }
}
